{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listening-audio",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "LISTENING_DATA",
      "id": "7049800c549243ff9652235169b1649b"
    }
  ],
  "observability": {
    "enabled": true
  }
}
